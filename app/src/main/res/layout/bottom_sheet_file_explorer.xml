<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_duration_badge"
        android:alpha="0.5" />

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvExplorerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/storage_file_explorer"
            android:textColor="@color/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExplorerSelectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/select_all"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <ImageView
                android:id="@+id/btnCloseExplorer"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/iconSecondary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Filter chips (All, Videos, Photos, Audio) -->
    <HorizontalScrollView
        android:id="@+id/layoutExplorerFilterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupExplorerFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/all"
                app:chipIcon="@drawable/ic_layers_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterVideos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/videos"
                app:chipIcon="@drawable/ic_play_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterImages"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/photos"
                app:chipIcon="@drawable/ic_image_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterAudio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio"
                app:chipIcon="@drawable/ic_audio_24" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Quick Location Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupLocations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDownloads"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/downloads"
                app:chipIcon="@drawable/ic_folder_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDcim"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dcim"
                app:chipIcon="@drawable/ic_image_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMovies"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/movies"
                app:chipIcon="@drawable/ic_play_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPictures"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pictures"
                app:chipIcon="@drawable/ic_image_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRootStorage"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/root_storage"
                app:chipIcon="@drawable/ic_folder_24" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Path Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_duration_badge"
        android:padding="6dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/btnUpDirectory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:src="@drawable/ic_chevron_right_24"
            android:rotation="180"
            app:tint="@color/colorPrimary" />

        <TextView
            android:id="@+id/tvCurrentPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="start"
            android:singleLine="true"
            android:text="@string/storage_root_path"
            android:textColor="@color/colorOnSurface"
            android:textSize="13sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Main Directory List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvExplorerNodes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/pbExplorerLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvExplorerEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/folder_empty"
            android:textColor="@color/iconSecondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Floating Import Bar for Multi-Select in Explorer -->
    <LinearLayout
        android:id="@+id/layoutExplorerBottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_nav_docked"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvExplorerSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/files_selected_zero"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplorerImportSelected"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="@string/import_zero"
            android:textColor="@color/onPrimaryContainer"
            android:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_arrow_up_right_24"
            app:iconGravity="textEnd"
            app:iconTint="@color/onPrimaryContainer"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
