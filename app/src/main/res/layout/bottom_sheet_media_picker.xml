<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <!-- Bottom Sheet Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_duration_badge"
        android:alpha="0.5" />

    <!-- CapCut / Shorts Style Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="6dp">

        <!-- Album Selector Dropdown Button -->
        <LinearLayout
            android:id="@+id/btnAlbumDropdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvSelectedAlbumName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Media"
                android:textColor="@color/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_right_24"
                android:rotation="90"
                app:tint="@color/colorOnSurface" />
        </LinearLayout>

        <!-- Right action buttons: Browse, Select All, Close -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBrowseFolders"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Browse"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                app:icon="@drawable/ic_folder_24"
                app:iconSize="16dp"
                app:iconTint="@color/colorPrimary"
                android:paddingHorizontal="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Select All"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:paddingHorizontal="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <ImageView
                android:id="@+id/btnCloseSheet"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/iconSecondary" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Filter Tabs (All, Videos, Photos, Audio) like Shorts/InShot -->
    <HorizontalScrollView
        android:id="@+id/layoutTabsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:visibility="visible">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All"
                app:chipIcon="@drawable/ic_layers_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipVideos"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Videos"
                app:chipIcon="@drawable/ic_play_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipImages"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photos"
                app:chipIcon="@drawable/ic_image_24" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAudio"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Audio"
                app:chipIcon="@drawable/ic_audio_24" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Main Media Grid -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMediaGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutEmptyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No media found on device."
                android:textColor="@color/iconSecondary"
                android:textSize="14sp"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGrantPermission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Allow Access to Media"
                android:textColor="#FFFFFF"
                app:cornerRadius="8dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSystemPickerFallback"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Browse Folders"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Floating Import Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomImportBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bottom_nav_docked"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 items selected"
            android:textColor="@color/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportSelected"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Import (0)"
            android:textColor="@color/onPrimaryContainer"
            android:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_arrow_up_right_24"
            app:iconGravity="textEnd"
            app:iconTint="@color/onPrimaryContainer"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

</LinearLayout>
